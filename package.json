{
    "name": "@nera-static/core",
    "version": "4.20.0",
    "description": "The Nera static site generator engine — the build pipeline and the layered theme/view resolver, importable by the Nera CLI, @nera-static/validate and tooling",
    "main": "./src/index.js",
    "type": "module",
    "exports": {
        ".": "./src/index.js",
        "./core": "./src/core.js",
        "./render": "./src/render.js",
        "./resolve": "./src/resolve.js",
        "./engine": "./src/engine.js",
        "./theme": "./src/theme.js",
        "./site-model": "./src/site-model.js",
        "./package.json": "./package.json"
    },
    "scripts": {
        "start": "nodemon",
        "serve": "vite",
        "lint": "nera-stan",
        "render": "node index.js",
        "preserve": "npm run render",
        "watch:assets": "node src/watch-assets.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "dev": "npm run render && concurrently -k -n 'vite,watch,server' -c blue,magenta,green \"npm:serve\" \"npm:watch:assets\" \"npm:start\"",
        "prepare": "husky"
    },
    "files": [
        "src/core.js",
        "src/engine.js",
        "src/index.js",
        "src/render.js",
        "src/resolve.js",
        "src/setup-plugins.js",
        "src/site-model.js",
        "src/theme.js",
        "index.js",
        "CHANGELOG.md"
    ],
    "keywords": [
        "static-site-generator",
        "markdown",
        "pug",
        "jamstack",
        "blog",
        "documentation",
        "website",
        "ssg"
    ],
    "author": "Michael Becker <micha.becker79@gmail.com> (https://github.com/seebaermichi)",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/seebaermichi/nera.git"
    },
    "bugs": {
        "url": "https://github.com/seebaermichi/nera/issues"
    },
    "homepage": "https://github.com/seebaermichi/nera#readme",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "dependencies": {
        "@nera-static/plugin-utils": "^1.8.0",
        "dotenv": "^18.0.4",
        "fs-readdir-recursive": "^1.1.0",
        "js-beautify": "^2.0.3",
        "markdown-it": "^15.0.0",
        "pug": "^3.0.2",
        "rimraf": "^6.0.1",
        "semver": "^7.8.5",
        "yaml": "^2.4.1"
    },
    "devDependencies": {
        "@nera-static/stan": "^1.1.0",
        "@nera-static/test-utils": "^1.0.1",
        "chokidar": "^6.0.0",
        "concurrently": "^10.0.3",
        "husky": "^9.1.7",
        "nodemon": "^3.0.3",
        "npm-run-all": "^4.1.5",
        "vite": "^8.1.5",
        "vitest": "^5.0.2"
    },
    "overrides": {
        "shell-quote": "^1.9.0"
    },
    "nera-stan": {
        "ignores": [
            "scripts/templates/"
        ]
    }
}
